# Backend environment (local development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forge_fitness
SECRET_KEY=replace-with-openssl-rand-hex-32
FRONTEND_ORIGIN=http://localhost:3000

# Admin account (plain password — init_db.py will hash it on first run)
# After first run, replace this with the Argon2 hash and restart.
ADMIN_EMAIL=admin@forgefitness.demo
ADMIN_PASSWORD_HASH=changeme

# Gym identity
GYM_ID=forge-fitness-mumbai
GYM_NAME=Forge Fitness Mumbai
